# Chave da Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# gemini | azure | higgsfield | mock | auto
# auto = gemini se houver GEMINI_API_KEY, senao azure, senao higgsfield, senao mock
VF_PROVIDER=auto

# Modelo de video
VF_MODEL=gemini-omni-1.1-flash

# Onde ficam banco e midias (relativo a video-factory/)
VF_STORAGE_DIR=storage

# --- Sora-2 no Microsoft Foundry (Azure OpenAI) ---
# O acesso ao sora-2 e gated: peca liberacao no formulario do Foundry.
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
VF_AZURE_DEPLOYMENT=sora-2
VF_AZURE_API_VERSION=preview
# videos = POST /openai/v1/videos (estilo OpenAI v1, padrao)
# generations = POST /openai/v1/video/generations (estilo antigo do Azure)
VF_AZURE_API_STYLE=videos

# --- Higgsfield (Wan 3.0 / Kling 3.0) ---
# Chaves em https://cloud.higgsfield.ai. Use o par id/secret OU HIGGSFIELD_API_KEY="id:secret".
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# wan3 | kling3
VF_HIGGSFIELD_MODEL=wan3
# Wan 3.0 ja vem com os endpoints documentados. Kling 3.0 exige o endpoint id do
# console (https://console.higgsfield.ai): sem isso o provider recusa com instrucao.
VF_HIGGSFIELD_KLING_T2V=
VF_HIGGSFIELD_KLING_I2V=

# --- camadas de marca (Remotion) ---
# Caminho de um chrome-headless-shell, se o Chrome do sistema nao servir.
VF_REMOTION_BROWSER=
VF_BRAND_ACCENT=#0f6cbd

VF_HOST=127.0.0.1
VF_PORT=8000
